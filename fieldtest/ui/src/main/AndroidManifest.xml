<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <activity
            android:name="com.tracewayapp.fieldmart.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Fieldmart"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stores the launch settings before a measured cold start; in its own process, where nothing else starts. -->
        <activity
            android:name="com.tracewayapp.fieldmart.ConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":config"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
